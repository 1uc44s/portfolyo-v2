{
  "name": "@my-portfolyo/backend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch-path=src --import ./scripts/dev-env.mjs src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node --env-file-if-exists=.env prisma/seed.mjs",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "admin:create": "node --env-file-if-exists=.env scripts/admin-create.mjs",
    "admin:reset-password": "node --env-file-if-exists=.env scripts/admin-reset-password.mjs",
    "admin:reset-2fa": "node --env-file-if-exists=.env scripts/admin-reset-2fa.mjs",
    "admin:unlock": "node --env-file-if-exists=.env scripts/admin-unlock.mjs",
    "admin:dev-set": "node --env-file-if-exists=.env scripts/admin-dev-set.mjs",
    "tech-stack:import": "node --env-file-if-exists=.env scripts/dev-tech-stack-import.mjs",
    "dev:reset-defaults": "node --env-file-if-exists=.env scripts/dev-reset-defaults.mjs"
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "2.1.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@my-portfolyo/shared": "*",
    "@zxcvbn-ts/core": "4.2.0",
    "@zxcvbn-ts/language-common": "4.1.3",
    "argon2": "0.45.2",
    "compression": "1.8.2",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "discord.js": "14.28.1",
    "express": "5.3.0",
    "ffmpeg-static": "5.3.0",
    "file-type": "22.3.0",
    "helmet": "8.3.0",
    "jose": "6.2.17",
    "libphonenumber-js": "1.12.10",
    "multer": "2.5.0",
    "music-metadata": "12.3.2",
    "nodemailer": "10.5.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "qrcode": "1.5.4",
    "rate-limiter-flexible": "11.4.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "prisma": "7.10.1"
  }
}
