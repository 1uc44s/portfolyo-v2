# ARCHITECTURE.md §10 — gerçek değerleri .env dosyasına yaz; .env commit'lenmez.
NODE_ENV=development
PORT=4000
PUBLIC_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=0
LOG_LEVEL=info

# F2'de zorunlu olur
DATABASE_URL=postgresql://vasquez:vasquez_dev_password@localhost:5447/vasquez

# Secret'lar — boş bırakılırsa API başlamaz. Üretmek için:
#   node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"   (JWT_ACCESS_SECRET)
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"   (CSRF_SECRET)
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"      (APP_ENCRYPTION_KEY)
# APP_ENCRYPTION_KEY kaybolursa DB'deki şifreli alanlar (2FA, SMTP, entegrasyon secret'ları) çözülemez — yedekle.
JWT_ACCESS_SECRET=
CSRF_SECRET=
APP_ENCRYPTION_KEY=

# Yalnızca `npm run admin:create` çalıştırılırken doldur, sonra sil (FR-SETUP-01).
# INITIAL_ADMIN_EMAIL=
# INITIAL_ADMIN_PASSWORD=

# F6 — medya hattı (ARCHITECTURE.md §8, §10). Göreli STORAGE_ROOT backend/ dizinine göre çözülür.
STORAGE_DRIVER=local
STORAGE_ROOT=./uploads
# Boşsa npm ile gelen ffmpeg-static / @ffprobe-installer kullanılır (ek kurulum gerekmez).
FFMPEG_PATH=
FFPROBE_PATH=

# F14 — Cloudflare Turnstile. Prod'da zorunlu; boşsa dev/test'te her zaman geçen test anahtarları.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# F15 — GitHub. Token opsiyonel (yalnızca public okuma; rate limit için). Kart servisleri değiştirilebilir.
GITHUB_TOKEN=
GITHUB_STATS_BASE_URL=https://github-readme-stats.vercel.app
GITHUB_STREAK_BASE_URL=https://streak-stats.demolab.com
