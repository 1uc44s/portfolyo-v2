# Üretim şablonu → /etc/vasquez/backend.env (sahip root:vasquez, mod 640). Gerçek değerler commit'lenmez.
NODE_ENV=production
PORT=4000
PUBLIC_ORIGIN=https://ALAN_ADI
CORS_ORIGINS=
TRUST_PROXY=1
LOG_LEVEL=info

DATABASE_URL=postgresql://portfolyo:GUCLU_SIFRE@127.0.0.1:5432/portfolyo_db

# node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"
JWT_ACCESS_SECRET=
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CSRF_SECRET=
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# KAYBOLURSA şifreli alanlar (2FA, SMTP, entegrasyon secret'ları) çözülemez — parola yöneticisinde ayrıca sakla.
APP_ENCRYPTION_KEY=

STORAGE_DRIVER=local
STORAGE_ROOT=/var/lib/vasquez/storage
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

# Cloudflare Turnstile — prod'da zorunlu
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Opsiyonel
GITHUB_TOKEN=
GITHUB_STATS_BASE_URL=https://github-readme-stats.vercel.app
GITHUB_STREAK_BASE_URL=https://streak-stats.demolab.com
